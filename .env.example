# Application
APP_NAME=StorePilot AI
WEB_URL=http://localhost:3000
API_URL=http://localhost:3000
PORT=3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shopify_agent
MONGODB_DB_NAME=shopify_agent

# Authentication
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Shopify
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_customers,read_draft_orders,read_inventory,read_marketing_events,read_orders,read_products,read_reports
SHOPIFY_API_VERSION=2026-01

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
